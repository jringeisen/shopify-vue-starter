{% comment %}
  Renders star rating visualization
  Accepts:
  - rating: {Number} Rating value (0-5)
{% endcomment %}

<div class="star-rating">
  {% assign stars_full = rating | floor %}
  {% assign stars_half = rating | modulo: 1 %}

  {% for i in (1..5) %}
    {% if i <= stars_full %}
      <span class="star star--full">★</span>
    {% elsif i == stars_full | plus: 1 and stars_half >= 0.5 %}
      <span class="star star--half">★</span>
    {% else %}
      <span class="star star--empty">☆</span>
    {% endif %}
  {% endfor %}
</div>

<style>
  .star-rating {
    display: inline-flex;
    color: #ffa500;
    font-size: 1.2rem;
  }

  .star {
    margin-right: 0.125rem;
  }

  .star--empty {
    opacity: 0.3;
  }
</style>
